{
  // domain ring: `effect` only. Holds the parser port *and* its text implementation,
  // because markdown and plain text need no platform at all.
  "extends": "../../../tsconfig.base.json",
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "compilerOptions": {
    "noEmit": true,
    // Tests sit beside src, so rootDir has to be the package rather than src/.
    "rootDir": ".",
    "types": []
  }
}
