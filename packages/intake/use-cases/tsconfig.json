{
  // use-cases ring: one file per business operation, plus the `.rpc.ts` transport
  // surface. Reaches SQL only through the `Db` seam, so these are testable with
  // fakes — no bindings, no database, no network.
  "extends": "../../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "noEmit": true,
    "types": []
  }
}
