{
  // The OpenAI-compatible language model adapter. This package exists to CONTAIN `@effect/ai-openai` (ADR-0021).
  //
  // `types: []`, as everywhere else: this package implements ports declared in `@ea/domain`, and it should not be
  // able to reach a platform global to do it.
  "extends": "../../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  // Tests are their own project. Overlapping includes would put a file in two projects, which
  // `tsc -b` rejects.
  "exclude": ["**/test/**"],
  "compilerOptions": {
    "noEmit": true,
    // The package, not `src`: a package-level `test/` sits beside `src/`, and where tests are nested
    // inside a ring they travel with it, so both live under this root.
    "rootDir": ".",
    "tsBuildInfoFile": ".tsbuildinfo/src.tsbuildinfo",
    "types": []
  }
}
