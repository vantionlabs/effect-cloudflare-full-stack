{
  // The Resend adapter for the `Email` port. This package exists to CONTAIN `resend` (ADR-0021).
  //
  // `types: []`, as everywhere else: this package implements the `Email` port from `@ea/modules/shared/domain`, and
  // it should not be able to reach a platform global to do it. The Resend SDK is `fetch`-based, so it does not
  // need one.
  "extends": "../../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  // Tests are their own project. Overlapping includes would put a file in two projects, which
  // `tsc -b` rejects.
  "exclude": ["**/test/**"],
  "compilerOptions": {
    "noEmit": true,
    // The package, not `src`: a package-level `test/` sits beside `src/`, and where tests are nested
    // inside a ring they travel with it, so both live under this root.
    "rootDir": ".",
    "tsBuildInfoFile": ".tsbuildinfo/src.tsbuildinfo",
    "types": []
  }
}
