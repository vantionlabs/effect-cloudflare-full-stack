{
  // tables ring, plus the two cross-slice compositions that have to live somewhere:
  // the migration ordering and the org-scoping seam. Knows `effect/sql`, never a
  // driver — the connection arrives through `Connect`, so the eval harness can
  // supply its own.
  "extends": "../../../tsconfig.base.json",
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "compilerOptions": {
    "noEmit": true,
    // Tests sit beside src, so rootDir has to be the package rather than src/.
    "rootDir": ".",
    "types": []
  }
}
