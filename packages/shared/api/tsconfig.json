{
  // The composed public contract. `api` is an addition to beep's role vocabulary:
  // the versioned wire surface is cross-slice by nature and has no home in
  // domain/tables/use-cases/server. Depends on each slice's domain; nothing in
  // `shared` depends on it.
  "extends": "../../../tsconfig.base.json",
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "compilerOptions": {
    "noEmit": true,
    // Tests sit beside src, so rootDir has to be the package rather than src/.
    "rootDir": ".",
    "types": []
  }
}
