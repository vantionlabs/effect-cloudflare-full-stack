{
  "name": "@ea/root",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/*/*",
      "apps/*",
      "evals",
      "scripts",
      "infra",
      "e2e"
    ],
    "catalog": {
      "@cloudflare/vite-plugin": "^1.62.1",
      "@effect/ai-openai": "4.0.0-rc.118",
      "@effect/atom-react": "4.0.0-rc.118",
      "@effect/sql-pg": "4.0.0-rc.118",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/ai": "^0.63.0",
      "@tanstack/react-form": "^1.33.5",
      "@tanstack/react-router": "^1.170.40",
      "@tanstack/react-start": "1.168.59",
      "@types/node": "25.1.0",
      "@vitejs/plugin-react": "^6.1.1",
      "effect": "4.0.0-rc.118",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "tailwindcss": "^4.3.3",
      "vite": "^8.3.1",
      "vitest": "5.0.2",
      "wrangler": "4.143.0"
    }
  },
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint && (git rev-parse --git-dir >/dev/null 2>&1 && lefthook install || true)",
    "check": "tsc -b tsconfig.json && tsc -p apps/console/tsconfig.json && tsc -p packages/modules/tsconfig.test.json && tsc -p packages/realtime/tsconfig.test.json && tsc -p packages/domain/tsconfig.test.json && tsc -p packages/database/tsconfig.test.json && tsc -p packages/integrations/better-auth/tsconfig.test.json && tsc -p packages/integrations/ai-openai/tsconfig.test.json && tsc -p packages/api/tsconfig.test.json && tsc -p evals/tsconfig.test.json && tsc -p apps/worker/tsconfig.test.json && tsc -p apps/worker/test/fixtures/workflow-probe/tsconfig.json && tsc -p apps/worker/test/fixtures/assistant-agent/tsconfig.json && tsc -p tsconfig.tools.json && tsc -p infra/tsconfig.json && tsc -p e2e/tsconfig.json",
    "check:watch": "tsc -b tsconfig.json --watch",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --disable-nested-config --fix",
    "fix": "bun run format && bun run lint:fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "knip": "knip",
    "secrets": "secretlint --secretlintignore .secretlintignore '**/*'",
    "deps:check": "syncpack lint",
    "deps:update": "syncpack update",
    "dep:check": "bun scripts/boundaries.ts",
    "hygiene": "bun run knip && bun run deps:check && bun run deps:workspace && bun run secrets && bun run dep:check && bun run bindings:check && bun run bundle:check && bun run auth:check",
    "preflight": "bun run format && bun run check && bun run lint && bun run hygiene && bun run test",
    "effect:verify": "bun scripts/verify-effect-api.ts",
    "evals": "bun evals/Decisions.ts",
    "evals:rule": "bun evals/CheckRule.ts",
    "dev": "bun run --filter @ea/worker dev",
    "infra:preview": "bun run --filter @ea/infra preview",
    "infra:up": "bun run --filter @ea/infra up",
    "infra:outputs": "bun run --filter @ea/infra outputs",
    "bindings:check": "bun scripts/bindings-check.ts",
    "deploy:staging": "bun run --filter @ea/worker deploy:staging",
    "deploy:production": "bun run --filter @ea/worker deploy:production",
    "auth:schema": "bun scripts/auth-schema.ts",
    "auth:check": "bun scripts/auth-schema.ts --check",
    "evals:retrieval": "bun evals/RetrievalRecall.ts",
    "db:verify": "bun scripts/verify-postgres.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "test:e2e": "bun run --filter @ea/e2e test",
    "bundle:check": "bun scripts/bundle-check.ts",
    "deps:workspace": "bun scripts/workspace-deps.ts"
  },
  "devDependencies": {
    "@effect/tsgo": "0.46.1",
    "@langchain/textsplitters": "^1.0.2",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.6",
    "@types/node": "catalog:",
    "better-auth": "1.7.6",
    "dprint": "0.57.4",
    "knip": "6.38.0",
    "lefthook": "2.1.14",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "secretlint": "13.0.6",
    "syncpack": "15.3.3",
    "typescript": "7.0.2",
    "vitest": "catalog:"
  },
  "dependencies": {}
}
