{
  // Tests, typechecked as a STANDALONE project — no project reference to the source.
  //
  // A referenced project must emit declarations (TS6310), and emitting here produced TS2878: with an
  // outDir the output layout no longer matches the input layout, so `tsc` cannot rewrite the repo's
  // explicit `.ts` import extensions. Nothing in this repo is published — wrangler and vite bundle
  // from source — so paying for declaration emit to satisfy a reference is fighting the design.
  //
  // Standalone means the source files these tests import are pulled in as ordinary files. Slightly
  // more work per run; no emit, and `check` runs it explicitly.
  //
  // `erasableSyntaxOnly` is off here, which PLAN.md always intended ("relaxed in the tests config").
  "extends": "../../tsconfig.base.json",
  "include": ["test/**/*.ts", "test/**/*.tsx"],
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "rootDir": ".",
    // Must match vite.config.ts's alias, or tsc and the bundler disagree about `@/`.
    /*
     * `bundler`, not the base's `NodeNext`.
     *
     * This app is bundled by Vite and never resolved by Node, so bundler resolution is the honest
     * description — and it is what lets `@/*` map to `./src/*` with extensionless imports. Under NodeNext
     * the mapping had to end in `.js` (TS2877 forbids a `.ts` extension on a non-relative path), and that
     * suffix leaked: the shadcn CLI resolved `@/lib/utils` to a directory called `lib.js`.
     *
     * saas-starter sets this repo-wide. Here it is scoped to the console, because the Worker and the
     * packages genuinely are Node/workerd-resolved.
     */
    // `module: preserve` comes with `moduleResolution: bundler` — the base sets `NodeNext` for both, and
    // TS rejects mixing one with the other (TS5095/TS5109). `preserve` is right for a bundled app: Vite
    // owns the module format, so tsc should not rewrite imports at all.
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": { "@/*": ["./src/*"] },
    "declaration": false,
    "declarationMap": false,
    "erasableSyntaxOnly": false,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"]
  }
}
