{
  // Tests, typechecked as a STANDALONE project — no project reference to the source.
  //
  // A referenced project must emit declarations (TS6310), and emitting here produced TS2878: with an
  // outDir the output layout no longer matches the input layout, so `tsc` cannot rewrite the repo's
  // explicit `.ts` import extensions. Nothing in this repo is published — wrangler and vite bundle
  // from source — so paying for declaration emit to satisfy a reference is fighting the design.
  //
  // Standalone means the source files these tests import are pulled in as ordinary files. Slightly
  // more work per run; no emit, and `check` runs it explicitly.
  //
  // `erasableSyntaxOnly` is off here, which PLAN.md always intended ("relaxed in the tests config").
  "extends": "../../tsconfig.base.json",
  "include": ["test/**/*.ts", "test/**/*.tsx"],
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "rootDir": ".",
    // Must match vite.config.ts's alias, or tsc and the bundler disagree about `@/`.
    /*
     * Mapped to `.js`, which is how saas-starter does it and is not a typo.
     *
     * Aliased imports are written WITHOUT an extension (`@/auth/SignIn`), unlike this repo's relative
     * imports which carry `.ts`. TS2877 forbids a `.ts` extension on a non-relative path because it
     * cannot be rewritten on emit — so the mapping supplies `.js`, and NodeNext resolves that back to
     * the `.ts` source. Vite's alias resolves the same specifier directly.
     */
    "paths": { "@/*": ["./src/*.js"] },
    "declaration": false,
    "declarationMap": false,
    "erasableSyntaxOnly": false,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"]
  }
}
