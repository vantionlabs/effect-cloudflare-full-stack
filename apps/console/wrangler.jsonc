{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "effect-ai-console",
  // ───────────────────────────────────────────────────────────────────────────────────────
  // A WORKER, not a Pages project. This is the ADR-0001 revisit.
  //
  // The console was a static SPA on Pages with a three-line Function forwarding `/api/*` to the API
  // Worker over a service binding. That shape worked and was verified end to end. It is being replaced
  // because SSR cannot be bolted onto static assets: a Pages project serves files, and "refuse this
  // route before any HTML is sent" needs a server that runs first.
  //
  // What is GAINED: real server-side auth. A `beforeLoad` running on the server can read the session
  // cookie, decide, and redirect — so an unauthenticated visitor never receives the authenticated shell.
  // On the SPA the only options were rendering then correcting (a flicker) or blocking on a client fetch
  // (a spinner). Also: SSR loaders call the API over the service binding IN-PROCESS, with no HTTP hop at
  // all, which is strictly better than the Function proxy it replaces.
  //
  // What is KEPT: one origin, and therefore none of the three cross-origin settings. The browser talks
  // only to this Worker; this Worker talks to the API over the binding. That was ADR-0001's actual
  // objective, and it survives the move.
  //
  // What is LOST: `pages deploy`'s preview-per-branch URLs. Workers has versioned previews instead, and
  // the deploy pipeline names environments explicitly rather than inferring them from a branch.
  // ───────────────────────────────────────────────────────────────────────────────────────
  //
  /*
   * OUR entry, not `@tanstack/react-start/server-entry`.
   *
   * Cloudflare's framework guide points `main` at the package export, which is the right default. This
   * console needs one branch in front of it: `/api/*` forwards to the API over the service binding so the
   * whole app stays ONE ORIGIN — which is what lets better-auth's client SDK and the existing typed RPC
   * client both work with no CORS, no trusted-origins list and no cookie domain.
   *
   * `src/server.ts` wraps the framework's own handler rather than reimplementing it, so there is nothing
   * to drift: Start's default entry is `createStartHandler(defaultStreamHandler)` and so is ours.
   */
  "main": "./src/server.ts",
  "compatibility_date": "2026-09-26",
  // Required by Start's server entry, which uses Node builtins through the framework rather than directly.
  "compatibility_flags": ["nodejs_compat"],

  /*
   * The API, over a service binding — Worker to Worker inside Cloudflare's network, no public request,
   * no egress, no token.
   *
   * This is now reachable from SSR loaders and server functions as `env.API.fetch(...)`, which is the
   * same capability the Pages Function had, available from every server-rendered route instead of only
   * from a catch-all proxy.
   */
  "services": [
    { "binding": "API", "service": "effect-ai" },
  ],

  "observability": {
    // Unlike Pages, a Worker accepts this — one of the smaller wins of the move, since the console's own
    // SSR errors now land in the same place the API's do.
    "enabled": true,
  },

  "env": {
    "staging": {
      "services": [
        // Non-inheritable, like every other binding: staging's console must reach STAGING's API, and
        // inheriting would silently point it at production.
        { "binding": "API", "service": "effect-ai-staging" },
      ],
      "observability": { "enabled": true },
    },
    "dev": {
      "services": [
        { "binding": "API", "service": "effect-ai-dev" },
      ],
      "observability": { "enabled": true },
    },
  },
}
