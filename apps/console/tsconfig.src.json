{
  // The browser ring. DOM lib, and NO @cloudflare/workers-types — which is the whole reason this is a
  // separate package rather than a second tsconfig inside apps/worker.
  //
  // Those two type environments are mutually exclusive: workers-types' Request/Response collide with
  // lib.dom. Two tsconfigs in one package was a workaround for a boundary; a package boundary IS the
  // boundary, and it lets `dep:check` forbid the console from importing a driver — which it could not do
  // while React and @effect/sql-pg sat in one dependency list.
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "compilerOptions": {
    "noEmit": true,
    /*
     * NOT composite, and therefore no declaration emit.
     *
     * Nothing imports this app — it is the deployed console, not a library — so emitting declarations buys
     * nothing and costs correctness: `composite` implies `declaration`, and declaration emit demands every
     * inferred type be nameable from outside. better-auth's client type is not (TS2883 names four internal
     * types it would have to reach), so the alternative was hand-annotating a type the library generates.
     *
     * The price is that this project cannot be a reference target, so it is typechecked by its own `tsc -p`
     * in `check` rather than through the root solution — the same shape the test and tools projects use.
     */
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": ".",
    // Must match vite.config.ts's alias, or tsc and the bundler disagree about `@/`.
    /*
     * `bundler`, not the base's `NodeNext`.
     *
     * This app is bundled by Vite and never resolved by Node, so bundler resolution is the honest
     * description — and it is what lets `@/*` map to `./src/*` with extensionless imports. Under NodeNext
     * the mapping had to end in `.js` (TS2877 forbids a `.ts` extension on a non-relative path), and that
     * suffix leaked: the shadcn CLI resolved `@/lib/utils` to a directory called `lib.js`.
     *
     * saas-starter sets this repo-wide. Here it is scoped to the console, because the Worker and the
     * packages genuinely are Node/workerd-resolved.
     */
    // `module: preserve` comes with `moduleResolution: bundler` — the base sets `NodeNext` for both, and
    // TS rejects mixing one with the other (TS5095/TS5109). `preserve` is right for a bundled app: Vite
    // owns the module format, so tsc should not rewrite imports at all.
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": { "@/*": ["./src/*"] },
    "tsBuildInfoFile": ".tsbuildinfo/src.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    /*
     * `@cloudflare/workers-types` is here now, which it deliberately was NOT before.
     *
     * The console used to be browser-only, and ADR-0001 kept workers-types out precisely because its
     * Request/Response collide with lib.dom. It now has a SERVER half — SSR and server functions running
     * in workerd, reading `env` from `cloudflare:workers` — so it needs both. They coexist because DOM
     * wins for the shared names and the Cloudflare-only globals are what we actually import by name.
     */
    "types": ["vite/client", "@cloudflare/workers-types"]
  }
}
