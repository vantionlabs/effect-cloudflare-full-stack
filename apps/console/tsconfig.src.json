{
  // The browser ring. DOM lib, and NO @cloudflare/workers-types — which is the whole reason this is a
  // separate package rather than a second tsconfig inside apps/worker.
  //
  // Those two type environments are mutually exclusive: workers-types' Request/Response collide with
  // lib.dom. Two tsconfigs in one package was a workaround for a boundary; a package boundary IS the
  // boundary, and it lets `dep:check` forbid the console from importing a driver — which it could not do
  // while React and @effect/sql-pg sat in one dependency list.
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // Must match vite.config.ts's alias, or tsc and the bundler disagree about `@/`.
    /*
     * Mapped to `.js`, which is how saas-starter does it and is not a typo.
     *
     * Aliased imports are written WITHOUT an extension (`@/auth/SignIn`), unlike this repo's relative
     * imports which carry `.ts`. TS2877 forbids a `.ts` extension on a non-relative path because it
     * cannot be rewritten on emit — so the mapping supplies `.js`, and NodeNext resolves that back to
     * the `.ts` source. Vite's alias resolves the same specifier directly.
     */
    "paths": { "@/*": ["./src/*.js"] },
    "tsBuildInfoFile": ".tsbuildinfo/src.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    /*
     * `@cloudflare/workers-types` is here now, which it deliberately was NOT before.
     *
     * The console used to be browser-only, and ADR-0001 kept workers-types out precisely because its
     * Request/Response collide with lib.dom. It now has a SERVER half — SSR and server functions running
     * in workerd, reading `env` from `cloudflare:workers` — so it needs both. They coexist because DOM
     * wins for the shared names and the Cloudflare-only globals are what we actually import by name.
     */
    "types": ["vite/client", "@cloudflare/workers-types"]
  }
}
