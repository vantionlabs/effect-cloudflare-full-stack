{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "effect-ai",
  "main": "src/Main.ts",
  "compatibility_date": "2026-09-26",
  // enable_request_signal lets toWebHandler's built-in interruptibility work: it
  // listens for request.signal abort and interrupts the fiber, so a client that
  // disconnects mid-request stops the work instead of paying for it.
  // nodejs_compat is on by default from 2026-08-04 but stays explicit to document
  // that node:stream (Duplex.fromWeb) is load-bearing here.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  /*
   * Logs AND traces. `traces` needs its own flag — verified against the docs, which say the top-level
   * setting "will not enable tracing by default, and will only enable logs". Cloudflare plans to change
   * that; until it does, `observability.enabled` alone is a Worker with no traces and nothing saying so.
   *
   * This matters more here than it would elsewhere: `Activity` wraps every workflow step in a span,
   * `effect/sql` traces queries and `LanguageModel` traces model calls, so the decide pipeline is fully
   * instrumented and was producing nothing on the Cloudflare side.
   *
   * `head_sampling_rate: 1` in dev because volume is nil and a missing trace while debugging is the
   * expensive kind of missing. Lower it per environment when traffic justifies it.
   */
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },

  /*
   * Smart placement, and it is motivated by a measurement rather than by a feeling.
   *
   * Postgres lives in `us-east-5`. A round trip from this machine measured ~120 ms against ~0.20 ms to a
   * local container (docs/adr/0015), and a Worker running at the edge nearest the *user* pays that latency
   * on every query. A decide workflow is many queries — the decide_key short circuit, the rule row, the
   * retrieval function, the decision and its citations, plus the workflow engine's memo reads and writes.
   *
   * Smart placement moves the Worker to a location near the origin instead of near the user, which is the
   * right trade for exactly this shape: several sequential round trips to one backend, where the request and
   * response are small. It is a hint, not a guarantee — Cloudflare decides per-Worker from observed traffic.
   *
   * Safe alongside the console: static assets are served BEFORE the Worker runs, so they keep being served
   * from the edge regardless of where the Worker is placed.
   *
   * `placement` is one of the few INHERITABLE keys, so it belongs here once rather than per environment.
   */
  "placement": { "mode": "smart" },

  // ───────────────────────────────────────────────────────────────────────────────────────
  // ⚠ BINDINGS ARE NOT INHERITED BY ENVIRONMENTS.
  //
  // Cloudflare: "Non-inheritable keys are configurable at the top-level, but cannot be
  // inherited by environments and must be specified for each environment."
  //
  // Every binding below MUST therefore be repeated in each `env.*` block. Forgetting one
  // deploys successfully and fails at runtime, so `bun run bindings:check` asserts that
  // each environment declares the same binding names as the top level. It runs in preflight.
  //
  // Resource ids come from `bun run infra:outputs` (Pulumi), never hand-invented.
  // ───────────────────────────────────────────────────────────────────────────────────────

  // The top level is LOCAL DEVELOPMENT. `wrangler dev` takes the Postgres connection string
  // from CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE in .env (gitignored), so
  // nothing needs provisioning on Cloudflare to run or test locally.
  /*
   * Hyperdrive, pointing at PlanetScale Postgres. **Caching must be DISABLED on this one.**
   *
   * `081514f5…` (planetscale-effect-ai-main-s36j) was created automatically with the database and reports
   * `caching: disabled` and the `postgres.rwgsxlfsivjd` role. The hand-made `3a73f8a5…` (effect-ai) has
   * caching ENABLED at the 60s default and uses the restricted `pscale_api_*` role — it was wired here first
   * and that was wrong.
   *
   * Why it matters, and it is plan risk R3 rather than a preference: Hyperdrive caches reads for 60 seconds
   * with **no write-through invalidation**. A reviewer who approves a decision and then sees it still sitting
   * in the queue is a bug, and a 60-second one is exactly long enough to be reported as flakiness rather than
   * diagnosed. Everything this binding serves is transactional — the queue, decision detail, the event rows —
   * so it cannot be cached.
   *
   * The cached config is not wasted: it is the right shape for the policy corpus, which is effectively static.
   * Wiring it is deliberately NOT done yet, because it uses a different database role whose privileges have
   * not been checked, and an unused binding on an unverified role is a trap for later.
   *
   * Local dev ignores this id entirely: `wrangler dev` substitutes
   * CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE from .env and talks to the compose container, so
   * tests keep running against a database that can be dropped and reseeded.
   *
   * Not a secret: an account-scoped identifier. Cloudflare holds the credentials behind it, which is the whole
   * point — the Worker never sees them.
   */
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "081514f5c4b1400a84d13d070ffb507e" },
  ],
  // `wrangler dev` emulates R2 locally via miniflare, so nothing needs provisioning to develop
  // or test. The real bucket is created by Pulumi (infra/index.ts).
  "r2_buckets": [
    { "binding": "DOCUMENTS", "bucket_name": "effect-ai-documents-dev" },
  ],
  // Workers AI, for embeddings via @cf/baai/bge-m3 (1024 dims, matching EMBEDDING_DIMENSIONS).
  // No account id or token needed from inside the Worker: the binding IS the authorisation. The
  // eval harness cannot use a binding, so it reaches the same model over REST with a token.
  /*
   * The console is NOT served here any more — it deploys to Cloudflare Pages (`apps/console/wrangler.jsonc`).
   *
   * There used to be an `assets` binding pointing at `../console/dist`, and ADR-0001 chose it for one origin,
   * no CORS and one deploy. The console moved to Pages as a product decision; the same-origin property was
   * kept rather than traded, by a Pages Function that forwards `/api/*` here over a service binding. So this
   * Worker now serves only the API, and the browser still only ever talks to one host.
   *
   * What changed in practice: two deploys instead of one, and the console can now be rolled back
   * independently — which is the upside ADR-0001 listed under plan risk R11 as the reason the split was a
   * pre-approved escape hatch.
   */
  /*
   * The read-through cache. `wrangler dev` emulates KV locally, so nothing needs provisioning to develop.
   *
   * What lives here is constrained by what KV is: eventually consistent, no atomic primitives, eviction at
   * the platform's discretion. `shared/domain/Cache/Cache.ts` carries the rule — the key must make staleness
   * impossible — and the list of what therefore may NOT be cached, including better-auth sessions
   * (`secondaryStorage` needs atomic `getAndDelete`/`increment`, so KV would silently break rate limiting)
   * and the armed auto-approve rule (disarming must be immediate).
   *
   * Today it holds exactly one thing: parsed document text, keyed by document id AND parser version.
   */
  "kv_namespaces": [
    { "binding": "CACHE", "id": "PULUMI_cacheNamespaceId" },
  ],
  /*
   * Analytics Engine, for the product's own rates. No resource to provision: a dataset is created on first
   * write, which is the same property that made Workers AI free to adopt.
   *
   * `writeDataPoint`'s arrays are POSITIONAL — there are no field names on the wire, so a query reads
   * `blob1`/`double2`. Inserting a value in the middle silently reinterprets every historical row. Append
   * only; the mapping is documented in `platform/TelemetryAnalytics.ts`.
   */
  "analytics_engine_datasets": [
    { "binding": "METRICS", "dataset": "effect_ai_decisions_dev" },
  ],
  "ai": { "binding": "AI" },
  /*
   * One queue carrying a tagged union, not a queue per event type.
   *
   * `max_retries: 5` with Queues' own backoff. `max_batch_size: 10` because each message opens a
   * scoped database connection and Workers allows six simultaneous outgoing connections per
   * invocation — which is also why the consumer processes a batch sequentially rather than in
   * parallel.
   *
   * The DLQ consumer writes `events.status = 'dead'`, so a dead letter is visible in the product
   * rather than only in a dashboard. `wrangler dev` emulates queues locally, so nothing needs
   * provisioning to develop or test.
   */
  "queues": {
    "producers": [
      { "binding": "EVENTS", "queue": "effect-ai-events-dev" },
    ],
    "consumers": [
      {
        "queue": "effect-ai-events-dev",
        "max_retries": 5,
        "max_batch_size": 10,
        "dead_letter_queue": "effect-ai-events-dlq-dev",
      },
    ],
  },

  // Each environment deploys as its own Worker: effect-ai-staging, effect-ai-production.
  // Separate bindings, separate secrets, separate logs.
  "env": {
    "staging": {
      "vars": { "ENVIRONMENT": "staging" },
      /*
       * The API on its own subdomain — the real-world shape.
       *
       * `custom_domain: true` makes Cloudflare create and manage the DNS record and the certificate, rather
       * than requiring a proxied record to exist first. It needs a ZONE: this account has none yet (verified
       * against the API), so these are commented with the domain to fill in rather than left as a
       * placeholder that would fail at deploy with a confusing error.
       *
       * Activating this means setting CONSOLE_ORIGIN and COOKIE_DOMAIN as well. All three together — a
       * deployment with two of the three logs a user in and then silently logs them out, because the cookie
       * is set for a host the browser does not send it to, and nothing errors.
       */
      // "routes": [
      //   { "pattern": "api-staging.example.com", "custom_domain": true },
      // ],
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "PULUMI_hyperdriveId" },
      ],
      "r2_buckets": [
        { "binding": "DOCUMENTS", "bucket_name": "effect-ai-documents-staging" },
      ],
      "kv_namespaces": [
        { "binding": "CACHE", "id": "PULUMI_cacheNamespaceId" },
      ],
      "analytics_engine_datasets": [
        { "binding": "METRICS", "dataset": "effect_ai_decisions_staging" },
      ],
      "ai": { "binding": "AI" },
      "queues": {
        "producers": [
          { "binding": "EVENTS", "queue": "effect-ai-events-staging" },
        ],
        "consumers": [
          {
            "queue": "effect-ai-events-staging",
            "max_retries": 5,
            "max_batch_size": 10,
            "dead_letter_queue": "effect-ai-events-dlq-staging",
          },
        ],
      },
    },
    "production": {
      "vars": { "ENVIRONMENT": "production" },
      /*
       * The API on its own subdomain — the real-world shape.
       *
       * `custom_domain: true` makes Cloudflare create and manage the DNS record and the certificate, rather
       * than requiring a proxied record to exist first. It needs a ZONE: this account has none yet (verified
       * against the API), so these are commented with the domain to fill in rather than left as a
       * placeholder that would fail at deploy with a confusing error.
       *
       * Activating this means setting CONSOLE_ORIGIN and COOKIE_DOMAIN as well. All three together — a
       * deployment with two of the three logs a user in and then silently logs them out, because the cookie
       * is set for a host the browser does not send it to, and nothing errors.
       */
      // "routes": [
      //   { "pattern": "api.example.com", "custom_domain": true },
      // ],
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "PULUMI_hyperdriveId" },
      ],
      "r2_buckets": [
        { "binding": "DOCUMENTS", "bucket_name": "effect-ai-documents-production" },
      ],
      "kv_namespaces": [
        { "binding": "CACHE", "id": "PULUMI_cacheNamespaceId" },
      ],
      "analytics_engine_datasets": [
        { "binding": "METRICS", "dataset": "effect_ai_decisions_staging" },
      ],
      "ai": { "binding": "AI" },
      "queues": {
        "producers": [
          { "binding": "EVENTS", "queue": "effect-ai-events-production" },
        ],
        "consumers": [
          {
            "queue": "effect-ai-events-production",
            "max_retries": 5,
            "max_batch_size": 10,
            "dead_letter_queue": "effect-ai-events-dlq-production",
          },
        ],
      },
    },
  },
}
