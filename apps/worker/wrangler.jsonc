{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "effect-ai",
  "main": "src/Main.ts",
  "compatibility_date": "2026-09-26",
  // enable_request_signal lets toWebHandler's built-in interruptibility work: it
  // listens for request.signal abort and interrupts the fiber, so a client that
  // disconnects mid-request stops the work instead of paying for it.
  // nodejs_compat is on by default from 2026-08-04 but stays explicit to document
  // that node:stream (Duplex.fromWeb) is load-bearing here.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "observability": { "enabled": true },

  // ───────────────────────────────────────────────────────────────────────────────────────
  // ⚠ BINDINGS ARE NOT INHERITED BY ENVIRONMENTS.
  //
  // Cloudflare: "Non-inheritable keys are configurable at the top-level, but cannot be
  // inherited by environments and must be specified for each environment."
  //
  // Every binding below MUST therefore be repeated in each `env.*` block. Forgetting one
  // deploys successfully and fails at runtime, so `bun run bindings:check` asserts that
  // each environment declares the same binding names as the top level. It runs in preflight.
  //
  // Resource ids come from `bun run infra:outputs` (Pulumi), never hand-invented.
  // ───────────────────────────────────────────────────────────────────────────────────────

  // The top level is LOCAL DEVELOPMENT. `wrangler dev` takes the Postgres connection string
  // from CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE in .env (gitignored), so
  // nothing needs provisioning on Cloudflare to run or test locally.
  /*
   * Hyperdrive, pointing at PlanetScale Postgres. **Caching must be DISABLED on this one.**
   *
   * `081514f5…` (planetscale-effect-ai-main-s36j) was created automatically with the database and reports
   * `caching: disabled` and the `postgres.rwgsxlfsivjd` role. The hand-made `3a73f8a5…` (effect-ai) has
   * caching ENABLED at the 60s default and uses the restricted `pscale_api_*` role — it was wired here first
   * and that was wrong.
   *
   * Why it matters, and it is plan risk R3 rather than a preference: Hyperdrive caches reads for 60 seconds
   * with **no write-through invalidation**. A reviewer who approves a decision and then sees it still sitting
   * in the queue is a bug, and a 60-second one is exactly long enough to be reported as flakiness rather than
   * diagnosed. Everything this binding serves is transactional — the queue, decision detail, the event rows —
   * so it cannot be cached.
   *
   * The cached config is not wasted: it is the right shape for the policy corpus, which is effectively static.
   * Wiring it is deliberately NOT done yet, because it uses a different database role whose privileges have
   * not been checked, and an unused binding on an unverified role is a trap for later.
   *
   * Local dev ignores this id entirely: `wrangler dev` substitutes
   * CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE from .env and talks to the compose container, so
   * tests keep running against a database that can be dropped and reseeded.
   *
   * Not a secret: an account-scoped identifier. Cloudflare holds the credentials behind it, which is the whole
   * point — the Worker never sees them.
   */
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "081514f5c4b1400a84d13d070ffb507e" },
  ],
  // `wrangler dev` emulates R2 locally via miniflare, so nothing needs provisioning to develop
  // or test. The real bucket is created by Pulumi (infra/index.ts).
  "r2_buckets": [
    { "binding": "DOCUMENTS", "bucket_name": "effect-ai-documents-dev" },
  ],
  // Workers AI, for embeddings via @cf/baai/bge-m3 (1024 dims, matching EMBEDDING_DIMENSIONS).
  // No account id or token needed from inside the Worker: the binding IS the authorisation. The
  // eval harness cannot use a binding, so it reaches the same model over REST with a token.
  /*
   * The reviewer console, built by `apps/console` and served as static assets.
   *
   * ONE deploy, TWO packages. ADR-0001 keeps a single Worker — one origin, one auth seam, no CORS, assets
   * served before the Worker runs — and that never required a single package. The console has its own
   * `tsconfig` with DOM and no workers-types, which is a boundary a package can express and two tsconfigs in
   * one package could only approximate.
   */
  "assets": { "directory": "../console/dist", "binding": "ASSETS" },
  "ai": { "binding": "AI" },
  /*
   * One queue carrying a tagged union, not a queue per event type.
   *
   * `max_retries: 5` with Queues' own backoff. `max_batch_size: 10` because each message opens a
   * scoped database connection and Workers allows six simultaneous outgoing connections per
   * invocation — which is also why the consumer processes a batch sequentially rather than in
   * parallel.
   *
   * The DLQ consumer writes `events.status = 'dead'`, so a dead letter is visible in the product
   * rather than only in a dashboard. `wrangler dev` emulates queues locally, so nothing needs
   * provisioning to develop or test.
   */
  "queues": {
    "producers": [
      { "binding": "EVENTS", "queue": "effect-ai-events-dev" },
    ],
    "consumers": [
      {
        "queue": "effect-ai-events-dev",
        "max_retries": 5,
        "max_batch_size": 10,
        "dead_letter_queue": "effect-ai-events-dlq-dev",
      },
    ],
  },

  // Each environment deploys as its own Worker: effect-ai-staging, effect-ai-production.
  // Separate bindings, separate secrets, separate logs.
  "env": {
    "staging": {
      "vars": { "ENVIRONMENT": "staging" },
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "PULUMI_hyperdriveId" },
      ],
      "r2_buckets": [
        { "binding": "DOCUMENTS", "bucket_name": "effect-ai-documents-staging" },
      ],
      "ai": { "binding": "AI" },
      "queues": {
        "producers": [
          { "binding": "EVENTS", "queue": "effect-ai-events-staging" },
        ],
        "consumers": [
          {
            "queue": "effect-ai-events-staging",
            "max_retries": 5,
            "max_batch_size": 10,
            "dead_letter_queue": "effect-ai-events-dlq-staging",
          },
        ],
      },
    },
    "production": {
      "vars": { "ENVIRONMENT": "production" },
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "PULUMI_hyperdriveId" },
      ],
      "r2_buckets": [
        { "binding": "DOCUMENTS", "bucket_name": "effect-ai-documents-production" },
      ],
      "ai": { "binding": "AI" },
      "queues": {
        "producers": [
          { "binding": "EVENTS", "queue": "effect-ai-events-production" },
        ],
        "consumers": [
          {
            "queue": "effect-ai-events-production",
            "max_retries": 5,
            "max_batch_size": 10,
            "dead_letter_queue": "effect-ai-events-dlq-production",
          },
        ],
      },
    },
  },
}
