# Local dev points the Hyperdrive binding at the compose.yaml Postgres, so
# `wrangler dev` needs nothing provisioned on Cloudflare.
#
# Copy to .env (gitignored) and fill in, assembling the URL as:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
#   USER     = effect_ai          (see compose.yaml)
#   PASSWORD = local_dev_only     (see compose.yaml — local container only)
#   HOST     = localhost
#   PORT     = 55433              (deliberately not 5432 or docket's 55432)
#   DATABASE = effect_ai
#
# Written as components rather than a full URL because secretlint's
# connection-string rule cannot distinguish a placeholder from a real credential,
# and the rule is worth keeping armed.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# The same container, for the second Hyperdrive binding.
#
# Deployed, HYPERDRIVE and HYPERDRIVE_CACHED are two configs against one database, differing only in
# whether Hyperdrive caches reads (ADR-0002). Locally there is no Hyperdrive and no caching, so both
# point at the same Postgres — but wrangler still refuses to start unless EACH binding has a local
# string, which is how adding the second binding broke the worker test suite.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_CACHED=

# better-auth signing secret. Generate with: openssl rand -base64 32
# Must be at least 32 characters; better-auth warns below that and the app dies without it.
BETTER_AUTH_SECRET=

# The origin better-auth treats as canonical. Its CSRF check compares the request's Origin
# header against this, so it must match how the app is actually reached.
#
# The CONSOLE's dev origin, not the API's. Locally the API runs as an AUXILIARY Worker inside the
# console's vite dev server (apps/console/vite.config.ts), so it has no port of its own and every
# request arrives with `Origin: http://localhost:5173`.
#
# Leaving this unset is worse than wrong, and silently: wrangler then falls back to the `vars` in
# wrangler.jsonc, whose BASE_URL is the deployed **https** console. `useSecureCookies` is derived from
# that scheme, so the session cookie comes back marked `Secure`, the browser discards it on plain http,
# and sign-in returns 200 with no session — the mirror image of the production bug where the cookie
# was NOT marked Secure. Neither failure appears in a log.
BASE_URL=http://localhost:5173

# Every OTHER hostname this deployment answers on, comma-separated, as host patterns.
#
# Unnecessary locally, where BASE_URL is the only origin. It exists for Cloudflare Pages, where a
# preview deployment gets a new hostname per commit and per branch, so no single BASE_URL can name
# the origin the browser used — a deployed sign-up returned 403 INVALID_ORIGIN before this existed.
# The deployed values live in apps/worker/wrangler.jsonc; this is here so the variable is
# discoverable rather than surprising.
#
# Scope every pattern to a hostname you control. The wildcard crosses dots, so `*.pages.dev` would
# trust every Cloudflare Pages project on the internet.
#
# Locally BASE_URL is the only origin, so this can stay empty.
ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Tier 3 parsing: Mistral OCR, for scanned documents. OPTIONAL — absent means
# a scanned PDF is refused rather than read, which is the correct default for
# a tier billed at about $4 per 1,000 pages.
#
# BOTH or NEITHER. A key with no pinned model fails at startup on purpose: a
# parser version defines the verbatim contract, and `mistral-ocr-latest` would
# let a provider-side upgrade change what verifies (plan risk R6).
#
# Mistral is chosen over a US-intermediated route for residency (ADR-0006),
# and only its STATELESS endpoint is used, because Zero Data Retention covers
# stateless calls only (plan risk R8).
# ---------------------------------------------------------------------------
# MISTRAL_API_KEY=
# MISTRAL_OCR_MODEL=

# ---------------------------------------------------------------------------
# Transactional email (Resend) — OPTIONAL, and off is the normal local state.
#
# Unset, every auth email (verification, password reset, invitation) is
# printed to the Worker log as `email NOT SENT (console stub)` with the full
# body — so the link can be clicked straight from the terminal.
#
# BOTH or NEITHER. EMAIL_FROM must be on a domain verified in Resend; a wrong
# one is accepted by the API and dropped downstream, so a key without it
# fails at startup rather than sending from a default nobody chose.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM=

# Local runs use the DEV AI Gateway. Plain `wrangler dev` reads the top-level wrangler.jsonc, which is production's,
# so without this every local model call was logged and cached in the production gateway (found 2026-10-01: all 538
# production-gateway logs were local runs from AMS).
AI_GATEWAY=effect-ai-ai-dev
CLOUDFLARE_AI_GATEWAY=effect-ai-ai-dev
