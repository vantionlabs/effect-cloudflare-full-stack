# Local dev points the Hyperdrive binding at the compose.yaml Postgres, so
# `wrangler dev` needs nothing provisioned on Cloudflare.
#
# Copy to .env (gitignored) and fill in, assembling the URL as:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
#   USER     = effect_ai          (see compose.yaml)
#   PASSWORD = local_dev_only     (see compose.yaml — local container only)
#   HOST     = localhost
#   PORT     = 55433              (deliberately not 5432 or docket's 55432)
#   DATABASE = effect_ai
#
# Written as components rather than a full URL because secretlint's
# connection-string rule cannot distinguish a placeholder from a real credential,
# and the rule is worth keeping armed.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# The same container, for the second Hyperdrive binding.
#
# Deployed, HYPERDRIVE and HYPERDRIVE_CACHED are two configs against one database, differing only in
# whether Hyperdrive caches reads (ADR-0002). Locally there is no Hyperdrive and no caching, so both
# point at the same Postgres — but wrangler still refuses to start unless EACH binding has a local
# string, which is how adding the second binding broke the worker test suite.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_CACHED=

# better-auth signing secret. Generate with: openssl rand -base64 32
# Must be at least 32 characters; better-auth warns below that and the app dies without it.
BETTER_AUTH_SECRET=

# The origin better-auth treats as canonical. Its CSRF check compares the request's Origin
# header against this, so it must match how the app is actually reached.
BASE_URL=http://localhost:8799

# Every OTHER hostname this deployment answers on, comma-separated, as host patterns.
#
# Unnecessary locally, where BASE_URL is the only origin. It exists for Cloudflare Pages, where a
# preview deployment gets a new hostname per commit and per branch, so no single BASE_URL can name
# the origin the browser used — a deployed sign-up returned 403 INVALID_ORIGIN before this existed.
# The deployed values live in apps/worker/wrangler.jsonc; this is here so the variable is
# discoverable rather than surprising.
#
# Scope every pattern to a hostname you control. The wildcard crosses dots, so `*.pages.dev` would
# trust every Cloudflare Pages project on the internet.
ALLOWED_HOSTS=
