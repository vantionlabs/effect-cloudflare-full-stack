{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    // A Workers built-in module (cloudflare:sockets), not an npm package.
    "cloudflare",
    // Loaded by @effect/tsgo via the tsconfig `plugins` entry, never imported.
    "@effect/language-service",
    // Referenced by .secretlintrc.json, which knip does not parse.
    "@secretlint/secretlint-rule-preset-recommend",
  ],
  "workspaces": {
    "scripts": {
      // Standalone CLIs, invoked by package.json scripts rather than imported.
      "entry": ["*.ts"],
      "project": ["**/*.ts"],
    },
    "apps/worker": {
      "entry": ["test/**/*.ts"],
    },
    // Tests are entry points, not dead code.
    "packages/modules": {
      "entry": ["**/test/**/*.ts"],
    },
    "packages/api": {
      "entry": ["**/test/**/*.ts"],
    },
    "apps/console": {
      // The Worker's entry is `main` in wrangler.jsonc (src/server.ts), which knip finds on its own;
      // routes are discovered by TanStack Start's plugin, not imported.
      //
      "entry": [
        "src/routes/**/*.tsx",
        "test/**/*.tsx",
      ],
      /*
       * shadcn/ui components are VENDORED, not authored here.
       *
       * `shadcn add button` copies a whole component — variants, sub-parts and all — and using two of its
       * seven exports today is normal; the rest are used the first time a screen needs them. knip is
       * correct that they have no importer and wrong that they are dead, so this is an ignore rather than
       * a deletion. Editing one is fine and expected; that is the point of the registry model.
       *
       * The consequence worth naming: genuinely dead UI in here will not be reported. Components are
       * re-added by name, so the check that matters is whether `components.json` still lists things the
       * app stopped using.
       */
      "ignore": [
        "src/components/ui/**",
        "src/lib/utils.ts",
      ],
      "ignoreDependencies": [
        // shadcn's icon dependency, pulled in by registry components rather than imported by the app.
        "lucide-react",
        /*
         * `@tanstack/ai` is declared AHEAD of its first import, which knip is right to flag and which is
         * a deliberate exception rather than an oversight.
         *
         * It is the chat and agent layer the console is about to grow — `useChat`, streaming, tool calls —
         * and the `tanstack-ai` skill reads the installed version to give version-correct guidance. So the
         * dependency is what makes the tooling useful before the code exists.
         *
         * Delete this entry the moment something imports it: an unused dependency with a note explaining
         * why is exactly how a permanent unused dependency starts.
         */
        "@tanstack/ai",
      ],
    },
    "evals": {
      // Standalone gates, invoked by package.json scripts rather than imported.
      "entry": ["*.ts"],
    },
  },
}
